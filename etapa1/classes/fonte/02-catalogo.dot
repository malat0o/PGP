digraph G {
  graph [rankdir=TB, fontname="Segoe UI", nodesep="0.9", ranksep="0.9", pad="0.3", bgcolor="white", newrank=true];
  node [shape=plain, fontname="Segoe UI", fontsize="11"];
  edge [fontname="Segoe UI"];
  subgraph "cluster_catalogo" { label=<<b>Catálogo</b>>; fontsize="14"; style="filled,rounded"; fillcolor="#dbeafe"; color="#1d4ed8"; penwidth="1.5"; margin="18";
    "Artista" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><font point-size="10">«abstract»</font><br/><b><i>Artista</i></b></td></tr><tr><td align="left" balign="left" cellpadding="6">isni : String «id»<br align="left"/>nome : String<br align="left"/>anoInicioAtividade : Integer<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "Solista" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><b>Solista</b></td></tr><tr><td align="left" balign="left" cellpadding="6"> </td></tr><tr><td height="8"> </td></tr></table>>];
    "Grupo" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><b>Grupo</b></td></tr><tr><td align="left" balign="left" cellpadding="6"> </td></tr><tr><td height="8"> </td></tr></table>>];
    "Album" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><b>Album</b></td></tr><tr><td align="left" balign="left" cellpadding="6">mbid : String «id»<br align="left"/>titulo : String<br align="left"/>anoLancamento : Integer<br align="left"/>tipo : TipoAlbum<br align="left"/>imagemCapa : Imagem [0..1]<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "Cancao" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><b>Cancao</b></td></tr><tr><td align="left" balign="left" cellpadding="6">isrc : String «id»<br align="left"/>titulo : String<br align="left"/>duracao : Integer<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "Faixa" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><b>Faixa</b></td></tr><tr><td align="left" balign="left" cellpadding="6">numero : Integer<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "VersaoAlbum" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><b>VersaoAlbum</b></td></tr><tr><td align="left" balign="left" cellpadding="6">ean13 : String «id»<br align="left"/>suporte : SuporteFisico<br align="left"/>designacao : String [0..1]<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "TipoAlbum" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><font point-size="10">«enumeration»</font><br/><b>TipoAlbum</b></td></tr><tr><td align="left" balign="left" cellpadding="6">single<br align="left"/>EP<br align="left"/>LP<br align="left"/></td></tr></table>>];
    "SuporteFisico" [label=<<table border="0" cellborder="1" cellspacing="0" color="#1d4ed8" bgcolor="white"><tr><td bgcolor="#dbeafe" cellpadding="6"><font point-size="10">«enumeration»</font><br/><b>SuporteFisico</b></td></tr><tr><td align="left" balign="left" cellpadding="6">CD<br align="left"/>vinil<br align="left"/>cassete<br align="left"/></td></tr></table>>];
  }
  "Artista" -> "Solista" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="back", arrowtail="onormal", arrowsize="1.3"];
  "Artista" -> "Grupo" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="back", arrowtail="onormal", arrowsize="1.3"];
  "Grupo" -> "Solista" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="none", taillabel="0..*", headlabel="0..*", label=" membros "];
  "Album" -> "Artista" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..*", headlabel="0..1", label=" interpretado por "];
  "Cancao" -> "Artista" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..*", headlabel="1..*", label=" interpretada por "];
  "Album" -> "Faixa" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="both", arrowtail="diamond", arrowhead="none", arrowsize="1.1", taillabel="1", headlabel="0..*", label=" faixas "];
  "Faixa" -> "Cancao" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..*", headlabel="1"];
  "Album" -> "VersaoAlbum" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="both", arrowtail="diamond", arrowhead="none", arrowsize="1.1", taillabel="1", headlabel="1..*", label=" versões "];
  "nota_Artista" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-07: isni tem 16 dígitos<br align="left"/>RI-08: anoInicioAtividade entre 1900 e 2100<br align="left"/>RI-35: isni único<br align="left"/>>];
  "nota_Artista" -> "Artista" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_Grupo" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-31: membros só podem ser solistas<br align="left"/>>];
  "nota_Grupo" -> "Grupo" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_Album" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-01: mbid tem 36 carateres<br align="left"/>RI-02: tipo é single, EP ou LP<br align="left"/>RI-09: anoLancamento entre 1900 e 2100<br align="left"/>RI-06, RI-10, RI-11: coerência com os artistas<br align="left"/>RI-32: no máximo 1 artista<br align="left"/>RI-33: mbid único<br align="left"/>>];
  "nota_Album" -> "Album" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_Cancao" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-04: isrc tem 12 carateres<br align="left"/>RI-05: duracao (segundos) positiva<br align="left"/>RI-34: isrc único<br align="left"/>>];
  "nota_Cancao" -> "Cancao" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_Faixa" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-03: numero começa em 1<br align="left"/>RI-38: numero único no álbum<br align="left"/>>];
  "nota_Faixa" -> "Faixa" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_VersaoAlbum" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-12: suporte é CD, vinil ou cassete<br align="left"/>RI-13: ean13 tem 13 dígitos<br align="left"/>RI-36: ean13 único<br align="left"/>RI-39: versões no mesmo suporte<br align="left"/>com designações distintas<br align="left"/>>];
  "nota_VersaoAlbum" -> "VersaoAlbum" [style=dashed, arrowhead=none, color="#a16207"];
}
