digraph G {
  graph [rankdir=LR, fontname="Segoe UI", nodesep="0.9", ranksep="0.9", pad="0.3", bgcolor="white", newrank=true];
  node [shape=plain, fontname="Segoe UI", fontsize="11"];
  edge [fontname="Segoe UI"];
  subgraph "cluster_colecoes" { label=<<b>Coleções e listas</b>>; fontsize="14"; style="filled,rounded"; fillcolor="#f3e8ff"; color="#7e22ce"; penwidth="1.5"; margin="18";
    "ItemColecao" [label=<<table border="0" cellborder="1" cellspacing="0" color="#7e22ce" bgcolor="white"><tr><td bgcolor="#f3e8ff" cellpadding="6"><b>ItemColecao</b></td></tr><tr><td align="left" balign="left" cellpadding="6">dataRegisto : Date<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "ListaPersonalizada" [label=<<table border="0" cellborder="1" cellspacing="0" color="#7e22ce" bgcolor="white"><tr><td bgcolor="#f3e8ff" cellpadding="6"><b>ListaPersonalizada</b></td></tr><tr><td align="left" balign="left" cellpadding="6">nome : String<br align="left"/>dataUltimaModificacao : DateTime<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "ItemLista" [label=<<table border="0" cellborder="1" cellspacing="0" color="#7e22ce" bgcolor="white"><tr><td bgcolor="#f3e8ff" cellpadding="6"><b>ItemLista</b></td></tr><tr><td align="left" balign="left" cellpadding="6">dataAdicao : Date<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
  }
  "Utilizador" [label=<<table border="0" cellborder="1" cellspacing="0" color="#94a3b8" bgcolor="white"><tr><td bgcolor="#f1f5f9" cellpadding="6" width="200"><b>Utilizador</b></td></tr></table>>];
  "VersaoAlbum" [label=<<table border="0" cellborder="1" cellspacing="0" color="#94a3b8" bgcolor="white"><tr><td bgcolor="#f1f5f9" cellpadding="6" width="200"><b>VersaoAlbum</b></td></tr></table>>];
  "Album" [label=<<table border="0" cellborder="1" cellspacing="0" color="#94a3b8" bgcolor="white"><tr><td bgcolor="#f1f5f9" cellpadding="6" width="200"><b>Album</b></td></tr></table>>];
  "LinhaFatura" [label=<<table border="0" cellborder="1" cellspacing="0" color="#94a3b8" bgcolor="white"><tr><td bgcolor="#f1f5f9" cellpadding="6"><b>LinhaFatura</b></td></tr></table>>];
  "Utilizador" -> "ItemColecao" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="both", arrowtail="diamond", arrowhead="none", arrowsize="1.1", taillabel="1", headlabel="0..*", label=" coleção "];
  "ItemColecao" -> "VersaoAlbum" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..*", headlabel="1"];
  "ItemColecao" -> "LinhaFatura" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..1", headlabel="0..1", label=" origem "];
  "Utilizador" -> "ListaPersonalizada" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="both", arrowtail="diamond", arrowhead="none", arrowsize="1.1", taillabel="1", headlabel="0..*", label=" listas "];
  "ListaPersonalizada" -> "ItemLista" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="both", arrowtail="diamond", arrowhead="none", arrowsize="1.1", taillabel="1", headlabel="0..*", label=" álbuns "];
  "ItemLista" -> "Album" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..*", headlabel="1"];
  "nota_ItemColecao" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-25: ano de dataRegisto ≥ anoLancamento<br align="left"/>RI-26: dataRegisto ≥ data em que fez 16 anos<br align="left"/>RI-41: cada versão só uma vez por utilizador<br align="left"/>RI-51: se tiver origem numa LinhaFatura, é a mesma<br align="left"/>versão, do utilizador da fatura, e dataRegisto = data da fatura<br align="left"/>>];
  "nota_ItemColecao" -> "ItemColecao" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_ListaPersonalizada" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-29: nome com no máximo 100 carateres<br align="left"/>RI-30: nome único para cada utilizador<br align="left"/>>];
  "nota_ListaPersonalizada" -> "ListaPersonalizada" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_ItemLista" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-42: cada álbum só uma vez por lista<br align="left"/>>];
  "nota_ItemLista" -> "ItemLista" [style=dashed, arrowhead=none, color="#a16207"];
}
