digraph G {
  graph [rankdir=LR, fontname="Segoe UI", nodesep="0.9", ranksep="0.9", pad="0.3", bgcolor="white", newrank=true];
  node [shape=plain, fontname="Segoe UI", fontsize="11"];
  edge [fontname="Segoe UI"];
  subgraph "cluster_pedidos" { label=<<b>Pedidos</b>>; fontsize="14"; style="filled,rounded"; fillcolor="#fee2e2"; color="#b91c1c"; penwidth="1.5"; margin="18";
    "PedidoNovaVersao" [label=<<table border="0" cellborder="1" cellspacing="0" color="#b91c1c" bgcolor="white"><tr><td bgcolor="#fee2e2" cellpadding="6"><b>PedidoNovaVersao</b></td></tr><tr><td align="left" balign="left" cellpadding="6">id : Integer «id»<br align="left"/>dataPedido : DateTime<br align="left"/>estado : EstadoPedido<br align="left"/>ean13 : String<br align="left"/>suporte : SuporteFisico<br align="left"/>designacao : String [0..1]<br align="left"/>dataResposta : DateTime [0..1]<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "Notificacao" [label=<<table border="0" cellborder="1" cellspacing="0" color="#b91c1c" bgcolor="white"><tr><td bgcolor="#fee2e2" cellpadding="6"><b>Notificacao</b></td></tr><tr><td align="left" balign="left" cellpadding="6">dataEmissao : DateTime<br align="left"/>lida : Boolean<br align="left"/></td></tr><tr><td height="8"> </td></tr></table>>];
    "EstadoPedido" [label=<<table border="0" cellborder="1" cellspacing="0" color="#b91c1c" bgcolor="white"><tr><td bgcolor="#fee2e2" cellpadding="6"><font point-size="10">«enumeration»</font><br/><b>EstadoPedido</b></td></tr><tr><td align="left" balign="left" cellpadding="6">emAnalise<br align="left"/>aceite<br align="left"/>recusado<br align="left"/></td></tr></table>>];
  }
  "Utilizador" [label=<<table border="0" cellborder="1" cellspacing="0" color="#94a3b8" bgcolor="white"><tr><td bgcolor="#f1f5f9" cellpadding="6" width="200"><b>Utilizador</b></td></tr></table>>];
  "Album" [label=<<table border="0" cellborder="1" cellspacing="0" color="#94a3b8" bgcolor="white"><tr><td bgcolor="#f1f5f9" cellpadding="6" width="200"><b>Album</b></td></tr></table>>];
  "VersaoAlbum" [label=<<table border="0" cellborder="1" cellspacing="0" color="#94a3b8" bgcolor="white"><tr><td bgcolor="#f1f5f9" cellpadding="6" width="200"><b>VersaoAlbum</b></td></tr></table>>];
  "Utilizador" -> "PedidoNovaVersao" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="none", taillabel="1", headlabel="0..*", label=" pedidos "];
  "PedidoNovaVersao" -> "Album" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..*", headlabel="1", label=" álbum "];
  "PedidoNovaVersao" -> "VersaoAlbum" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="forward", arrowhead="vee", taillabel="0..1", headlabel="0..1", label=" versão criada "];
  "PedidoNovaVersao" -> "Notificacao" [fontname="Segoe UI", fontsize="10", color="#334155", labelfontsize="10", labeldistance="2.4", labelangle="28", dir="both", arrowtail="diamond", arrowhead="none", arrowsize="1.1", taillabel="1", headlabel="0..1", label=" resposta "];
  "nota_PedidoNovaVersao" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-12: suporte é CD, vinil ou cassete<br align="left"/>RI-13: ean13 tem 13 dígitos<br align="left"/>RI-43: id único<br align="left"/>RI-44: estado inicial emAnalise<br align="left"/>RI-45: só aceite se o ean13 ainda não existir<br align="left"/>RI-49: dataResposta existe só se aceite ou recusado,<br align="left"/>e é ≥ dataPedido<br align="left"/>>];
  "nota_PedidoNovaVersao" -> "PedidoNovaVersao" [style=dashed, arrowhead=none, color="#a16207"];
  "nota_Notificacao" [shape=note, style=filled, fillcolor="#fef3c7", color="#a16207", fontsize="10", margin="0.12,0.06", label=<RI-50: criada com lida = falso<br align="left"/>>];
  "nota_Notificacao" -> "Notificacao" [style=dashed, arrowhead=none, color="#a16207"];
}
